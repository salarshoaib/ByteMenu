<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bytemenu.controller.MenuController"
      spacing="0" style="-fx-background-color:#F5F5F7;">

    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding:20 24 12 24;">
        <VBox spacing="2">
            <Label text="Browse Menu" styleClass="heading-1"/>
            <Label text="Select items to add to your cart" styleClass="label-muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField" promptText="🔍  Search items..." prefWidth="220"
                   onKeyReleased="#handleSearch"/>
    </HBox>

    <HBox fx:id="categoryBar" spacing="8" style="-fx-padding:0 24 14 24;">
        <Button text="All"         styleClass="tab-btn-active" onAction="#filterAll"      fx:id="btnAll"/>
        <Button text="Main Course" styleClass="tab-btn"        onAction="#filterMain"     fx:id="btnMain"/>
        <Button text="Snacks"      styleClass="tab-btn"        onAction="#filterSnacks"   fx:id="btnSnacks"/>
        <Button text="Drinks"      styleClass="tab-btn"        onAction="#filterDrinks"   fx:id="btnDrinks"/>
        <Button text="Desserts"    styleClass="tab-btn"        onAction="#filterDesserts" fx:id="btnDesserts"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                style="-fx-background:transparent;-fx-background-color:transparent;-fx-border-color:transparent;">
        <!-- GridPane is injected here by MenuController with 4 equal columns -->
        <VBox fx:id="menuGridContainer" style="-fx-padding:0 24 16 24;" fillWidth="true"/>
    </ScrollPane>

</VBox>
